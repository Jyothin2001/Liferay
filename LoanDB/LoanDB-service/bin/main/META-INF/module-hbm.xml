		<property access="com.liferay.portal.dao.orm.hibernate.MethodPropertyAccessor" name="customerId" type="com.liferay.portal.dao.orm.hibernate.LongType" />
		<property access="com.liferay.portal.dao.orm.hibernate.MethodPropertyAccessor" name="amount" type="com.liferay.portal.dao.orm.hibernate.DoubleType" />
		<property access="com.liferay.portal.dao.orm.hibernate.MethodPropertyAccessor" name="interestRate" type="com.liferay.portal.dao.orm.hibernate.DoubleType" />
		<property access="com.liferay.portal.dao.orm.hibernate.MethodPropertyAccessor" name="loanType" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property access="com.liferay.portal.dao.orm.hibernate.MethodPropertyAccessor" name="tenureMonths" type="com.liferay.portal.dao.orm.hibernate.IntegerType" />
	</class>
</hibernate-mapping>